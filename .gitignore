# Rust build artifacts
/target/
**/*.rs.bk

# Generated release outputs
/dist/

# Self-update staging (when a local build updates itself in place)
/update/
IdleTrigger.exe.old
IdleTrigger.exe.new

# Devtools capture output (lands next to the EXE)
IdleTrigger-*-capture.bmp

# Runtime config and logs generated next to the EXE
IdleTrigger.toml
IdleTrigger.toml.bak
IdleTrigger.state.json
IdleTrigger.state.json.corrupt-*
IdleTrigger.log
IdleTrigger.log.*
IdleTrigger-panic.txt
# save_candidate writes .{file}-{pid}.tmp (config + state); the screenshot
# pattern predates the current BMP capture path but stays harmless.
.IdleTrigger*.tmp
.IdleTrigger-screenshot-*.png.tmp

# Local diagnostic/scratch folders (screenshots land wherever the EXE runs)
/design-review/
/scratch-test/

# Editor backup files
*.swp
*.swo
*~

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
Desktop.ini
/.agents/
